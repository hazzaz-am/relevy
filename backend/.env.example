# Copy this file to .env and fill it in.

# Provider 1: OpenRouter (uses OpenRouter credits)
# OPENROUTER_API_KEY=sk-or-v1-...
# TYPESAFE_BASE_URL=https://openrouter.ai/api

# Provider 2: TypeSafe AI direct
# TYPESAFE_API_KEY=your-key

# Provider 3: Demo mode (offline keyword guesses, no API key needed)
TYPESAFE_API_KEY=demo

# Pin a version once results look right; jev-latest moves with each release.
JEV_MODEL=jev-latest

PORT=8787

# For publishing: your extension's origin from chrome://extensions, comma separated.
# Left empty, any chrome-extension:// origin is accepted (fine for local dev).
ALLOWED_ORIGINS=

# Posts one install may score per minute.
RATE_LIMIT_POSTS_PER_MIN=300

# Parallel Jev requests per batch.
JEV_CONCURRENCY=8
